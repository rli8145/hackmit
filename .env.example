# Company Brain — copy to .env and fill in what you have.
# The app runs fully WITHOUT any of these (offline fallbacks); each key lights
# up a real integration (and a sponsor track). Never commit your real .env.

# LLM extraction (OpenAI track). Without it, the rule-based fallback runs.
OPENAI_API_KEY=
CB_OPENAI_MODEL=gpt-4o-mini

# Raw-audio ingestion — speech-to-text (Deepgram track).
DEEPGRAM_API_KEY=

# The brain answers out loud — text-to-speech (ElevenLabs track).
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=Rachel

# Elasticsearch-backed search (Elastic track). Without it, in-memory search runs.
ELASTIC_URL=
ELASTIC_API_KEY=

# Server port (optional)
PORT=8000
